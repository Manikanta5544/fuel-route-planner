# Routing: with no ORS_API_KEY the app runs on the OSRM public demo automatically.
ROUTING_PROVIDER=auto
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org
REDIS_URL=
WEB_CONCURRENCY=2
START_TANK_BILLING=reference
STATION_PRICE_RULE=min
MAX_ROUTING_CALLS=3
RATE_LIMIT_PER_MIN=120
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
