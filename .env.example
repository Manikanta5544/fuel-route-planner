# Copy to .env (never commit it). Everything is optional: with no variables the app runs on the keyless OSRM demo.

# --- Routing ---
# auto: ORS when ORS_API_KEY is set, otherwise OSRM; ORS failures fall back to OSRM. Or force ors / osrm.
ROUTING_PROVIDER=auto
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_S=5          # read timeout per provider call
MAX_ROUTING_CALLS=3          # hard cap of provider calls per request (primary + border reroute + fallback)

# --- Cache / scaling ---
REDIS_URL=                   # empty = in-process cache only; compose sets redis://redis:6379/0
WEB_CONCURRENCY=1            # uvicorn worker processes (use >1 only with REDIS_URL set)

# --- Cost model ---
START_TANK_BILLING=reference # reference | excluded (how the free starting tank is valued in the estimate)
STATION_PRICE_RULE=min       # min | median | mean (ETL: price when a station has several rows)
RESERVE_MILES=0              # safety margin subtracted from the usable range

# --- Planner tuning ---
FREE_OFFSET_MILES=5
G_REF_GALLONS=25

# --- Service ---
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
RATE_LIMIT_PER_MIN=0         # per client IP; 0 = off
LOG_LEVEL=INFO
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=           # unused (no sessions/CSRF); random per process when empty
